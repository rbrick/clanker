# Optional S3-compatible bucket storage for generated snippet git repositories.
# Railway buckets expose S3-compatible AWS_* variables.
AWS_S3_BUCKET_NAME=your-bucket
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT_URL=https://your-s3-endpoint
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional prefix/path inside the bucket.
AWS_S3_PREFIX=clanker
AWS_S3_FORCE_PATH_STYLE=true

# Make git clone URLs point at the frontend or API host that proxies /git/*.
PUBLIC_BASE_URL=https://your-frontend-url
