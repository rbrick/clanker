# LLM provider: openai or openrouter
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini

# Database
# For local development:
DB_PROVIDER=sqlite
DB_URI=clanker.db
# For Railway Postgres, set these instead:
# DB_PROVIDER=postgres
# DB_URI=${DATABASE_URL}

# Telegram bot platform
# Leave empty/omit to run API-only.
TELEGRAM_BOT_KEY=your-telegram-bot-token

# Read-only API bind address.
# Railway injects PORT; use API_ADDR=:${PORT} in Railway variables.
API_ADDR=:8080

# Public URL used when the bot creates snippet links.
# Set this to your deployed NextJS/frontend URL, e.g. https://clanker-web.up.railway.app
SNIPPET_BASE_URL=http://localhost:3000
# Alternative fallback if SNIPPET_BASE_URL is unset.
PUBLIC_WEB_URL=http://localhost:3000

# NextJS frontend only. Points browser requests at the Go API service.
NEXT_PUBLIC_CLANKER_API_URL=http://localhost:8080
